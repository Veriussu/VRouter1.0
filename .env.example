# VRouter yapılandırma
PORT=10090
HOST=0.0.0.0

# Provider API anahtarlarını şifrelemek için kullanılır (üretimde mutlaka değiştirin)
ENCRYPTION_KEY=degistir-bu-degeri-uretimde

# models.dev kaynağı ve senkronizasyon aralığı (saat)
MODELS_DEV_URL=https://models.dev/api.json?type=all
SYNC_INTERVAL_HOURS=24

# Token sıkıştırma
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=2000

# İstek limitleri
MAX_REQUEST_BODY=25mb
REQUEST_TIMEOUT_MS=600000
